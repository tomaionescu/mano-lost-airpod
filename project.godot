; Engine configuration file.
config_version=5

[application]

config/name="Mano & the Lost AirPod"
config/description="A story adventure on the EPITA Kremlin-Bicetre campus."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.03, 0.035, 0.05, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/core/game_state.gd"
Sfx="*res://scripts/core/sfx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/dpi/allow_hidpi=true

[gui]

theme/custom_font="res://assets/fonts/AtkinsonHyperlegibleNext-VF.ttf"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/physics_interpolation=true

[rendering]

rendering_device/driver.macos="metal"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/use_taa=false
scaling_3d/mode=2
scaling_3d/scale=0.6
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/atlas_size=4096
environment/defaults/default_clear_color=Color(0.03, 0.035, 0.05, 1)
textures/default_filters/anisotropic_filtering_level=4
global_illumination/sdfgi/probe_ray_count=1
global_illumination/sdfgi/frames_to_converge=5
global_illumination/sdfgi/frames_to_update_lights=4
global_illumination/gi/use_half_resolution=true
anti_aliasing/screen_space_roughness_limiter/enabled=true

[importer_defaults]

texture={
"compress/mode": 2,
"compress/high_quality": false,
"mipmaps/generate": true
}
